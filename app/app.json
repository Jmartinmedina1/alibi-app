{
  "expo": {
    "name": "ALIBI",
    "slug": "alibi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alibi",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.josemartin.alibi",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2A30",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.josemartin.alibi"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ALIBI",
      "backgroundColor": "#0F2A30"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2A30",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-audio",
      "expo-localization",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "jose-martin-games",
    "extra": {
      "eas": {
        "projectId": "ea69f8a8-a261-4ebe-834a-242ba0163321"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ea69f8a8-a261-4ebe-834a-242ba0163321"
    }
  }
}
